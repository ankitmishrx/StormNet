# ==============================================================================
# STORMNET — Environment Configuration Template
# Convective Scale Nowcasting Platform (SIH26084)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Web Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_DEFAULT_LAT=28.6139
NEXT_PUBLIC_DEFAULT_LNG=77.2090
NEXT_PUBLIC_DEFAULT_ZOOM=8

# Database (PostgreSQL + PostGIS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stormnet_db
POSTGRES_USER=stormnet_user
POSTGRES_PASSWORD=stormnet_secret_password
DATABASE_URL=postgresql://stormnet_user:stormnet_secret_password@localhost:5432/stormnet_db
DATABASE_ASYNC_URL=postgresql+asyncpg://stormnet_user:stormnet_secret_password@localhost:5432/stormnet_db

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Operational Execution Mode: LIVE | REPLAY | SIMULATION
OPERATIONAL_MODE=SIMULATION

# Storage / Data Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SAMPLES_DIR=./data/samples
